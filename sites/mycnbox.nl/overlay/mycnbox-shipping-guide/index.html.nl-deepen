<script>
/* ══ i18n + currency engine ══ */
const LANGS=[
  {c:'en',l:'English',f:'🇺🇸'},{c:'es',l:'Español',f:'🇪🇸'},
  {c:'de',l:'Deutsch',f:'🇩🇪'},{c:'fr',l:'Français',f:'🇫🇷'},
  {c:'it',l:'Italiano',f:'🇮🇹'},{c:'pt',l:'Português',f:'🇧🇷'},
  {c:'nl',l:'Nederlands',f:'🇳🇱'},{c:'pl',l:'Polski',f:'🇵🇱'},
  {c:'zh',l:'中文',f:'🇨🇳'},
];
const CURRS=[
  {c:'CNY',s:'¥',r:1},
  {c:'USD',s:'$',r:0.138},{c:'EUR',s:'€',r:0.127},{c:'GBP',s:'£',r:0.109},
  {c:'JPY',s:'¥',r:21.4},
  {c:'AUD',s:'A$',r:0.212},{c:'CAD',s:'C$',r:0.189},{c:'BRL',s:'R$',r:0.69},
];
const PRICE_BASE='CNY';
const T={
  en:{buy:'MyCNBox →',no:'No products found.',sp:'Search MyCNBox products...',mt:'Language & Currency',ml:'LANGUAGE',mc:'CURRENCY',mb:'Confirm'},
  es:{buy:'Comprar en MyCNBox →',no:'Sin resultados.',sp:'Buscar en MyCNBox...',mt:'Idioma y Moneda',ml:'IDIOMA',mc:'MONEDA',mb:'Confirmar'},
  de:{buy:'Auf MyCNBox kaufen →',no:'Keine Produkte.',sp:'MyCNBox suchen...',mt:'Sprache & Währung',ml:'SPRACHE',mc:'WÄHRUNG',mb:'Bestätigen'},
  fr:{buy:'Acheter sur MyCNBox →',no:'Aucun résultat.',sp:'Rechercher MyCNBox...',mt:'Langue & Devise',ml:'LANGUE',mc:'DEVISE',mb:'Confirmer'},
  it:{buy:'Acquista su MyCNBox →',no:'Nessun prodotto.',sp:'Cerca su MyCNBox...',mt:'Lingua e Valuta',ml:'LINGUA',mc:'VALUTA',mb:'Conferma'},
  pt:{buy:'Comprar no MyCNBox →',no:'Sem resultados.',sp:'Buscar no MyCNBox...',mt:'Idioma e Moeda',ml:'IDIOMA',mc:'MOEDA',mb:'Confirmar'},
  nl:{buy:'Koop via MyCNBox →',no:'Geen producten gevonden.',sp:'Zoek MyCNBox producten...',mt:'Taal & Valuta',ml:'TAAL',mc:'VALUTA',mb:'Bevestigen'},
  pl:{buy:'Kup na MyCNBox →',no:'Brak produktów.',sp:'Szukaj MyCNBox...',mt:'Język i waluta',ml:'JĘZYK',mc:'WALUTA',mb:'Potwierdź'},
  zh:{buy:'在MyCNBox购买 →',no:'未找到商品。',sp:'搜索MyCNBox商品...',mt:'语言与货币',ml:'语言',mc:'货币',mb:'确认'},
};
let aL=localStorage.getItem('kd_lang')||'nl';
let aC=localStorage.getItem('kd_curr')||'EUR';
let pL=aL,pC=aC,mO=false;

function cvtFromCny(cny){const c=CURRS.find(x=>x.c===aC)||CURRS.find(x=>x.c===PRICE_BASE);const v=cny*c.r;return(['JPY','CNY'].includes(c.c))?c.s+Math.round(v).toLocaleString():c.s+v.toFixed(2);}
function fmtPrice(raw,cur){if(raw==null||raw==='')return'';const n=parseFloat(String(raw).replace(/[^\d.]/g,''));if(isNaN(n))return String(raw);const base=(cur||PRICE_BASE).toUpperCase();if(base!=='CNY')return String(raw);return cvtFromCny(n);}

function toggleLM(){mO?closeLM():openLM()}
function openLM(){pL=aL;pC=aC;buildG();['lang-modal','lang-backdrop'].forEach(id=>document.getElementById(id).classList.add('show'));document.getElementById('lang-btn').classList.add('open');document.body.style.overflow='hidden';mO=true;}
function closeLM(){['lang-modal','lang-backdrop'].forEach(id=>document.getElementById(id).classList.remove('show'));document.getElementById('lang-btn').classList.remove('open');document.body.style.overflow='';mO=false;}
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&mO)closeLM();});

function buildG(){
  document.getElementById('lang-grid').innerHTML=LANGS.map(l=>`<button class="lop${l.c===pL?' sel':''}" onclick="pL='${l.c}';buildG()">${l.f} ${l.l}</button>`).join('');
  document.getElementById('curr-grid').innerHTML=CURRS.map(c=>`<button class="lop${c.c===pC?' sel':''}" onclick="pC='${c.c}';buildG()">${c.c}</button>`).join('');
}
function applyLC(){
  aL=pL;aC=pC;
  localStorage.setItem('kd_lang',aL);localStorage.setItem('kd_curr',aC);
  closeLM();setBadge();applyT();
  if(typeof lp==='function')lp();else if(typeof loadProducts==='function')loadProducts();
}
function setBadge(){
  const l=LANGS.find(x=>x.c===aL)||LANGS[0];
  const c=CURRS.find(x=>x.c===aC)||CURRS[0];
  const btn=document.getElementById('lang-btn');
  if(!btn||!l||!c)return;
  document.getElementById('lc-flag').textContent=l.f;
  document.getElementById('lc-lang').textContent=l.c.toUpperCase();
  document.getElementById('lc-curr').textContent='· '+c.c;
}
function applyT(){
  const t=T[aL]||T.en;
  document.querySelectorAll('[data-t]').forEach(el=>{const k=el.getAttribute('data-t');if(t[k])el.textContent=t[k];});
  const si=document.getElementById('search-input');if(si)si.placeholder=t.sp;
}
function toggleFaq(el){const i=el.closest('.faq-item'),w=i.classList.contains('open');document.querySelectorAll('.faq-item').forEach(x=>x.classList.remove('open'));if(!w)i.classList.add('open');}
document.addEventListener('DOMContentLoaded',()=>{buildG();setBadge();applyT();if(typeof lp==='function')lp();});
</script>
<script>
const RATES={"us": {"dhl": [38, 8.0], "ems": [24, 4.8], "ecoA": [16, 3.0], "ecoB": [11, 1.9]}, "uk": {"dhl": [34, 7.2], "ems": [21, 4.2], "ecoA": [14, 2.7], "ecoB": [10, 1.7]}, "de": {"dhl": [33, 7.0], "ems": [20, 4.0], "ecoA": [13, 2.5], "ecoB": [9, 1.6]}, "fr": {"dhl": [34, 7.2], "ems": [21, 4.2], "ecoA": [14, 2.7], "ecoB": [10, 1.7]}, "other": {"dhl": [42, 9.0], "ems": [28, 5.5], "ecoA": [19, 3.6], "ecoB": [14, 2.3]}};
let cW=700;
function sw2(g){cW=g;document.getElementById('cw').value=g;document.querySelectorAll('.cpr').forEach(b=>b.classList.toggle('on',b.textContent.includes(g+'g')||b.textContent.includes((g/1000).toFixed(1)+'kg')));cu();}
function cc2(){const m={'shoes':700,'clothing':350,'jacket':1200,'bag':1100,'accessories':200};const v=document.getElementById('ccat').value;if(m[v]){cW=m[v];document.getElementById('cw').value=cW;}cu();}
function cu(show){
  const c=document.getElementById('cc').value;
  cW=parseInt(document.getElementById('cw').value)||700;
  const r=RATES[c]||RATES['other'];
  const calc=(b,e)=>Math.round((b+Math.max(0,Math.round((cW-700)/100))*e)*10)/10;
  const rows=[
    {n:'DHL Express',d:'df',t:'5&ndash;10 days',p:calc(r.dhl[0],r.dhl[1]),best:false},
    {n:'EMS',d:'dm',t:'10&ndash;20 days',p:calc(r.ems[0],r.ems[1]),best:false},
    {n:'Economy Line A',d:'dm',t:'15&ndash;30 days',p:calc(r.ecoA[0],r.ecoA[1]),best:true},
    {n:'Economy Line B',d:'ds',t:'25&ndash;45 days',p:calc(r.ecoB[0],r.ecoB[1]),best:false},
  ];
  document.getElementById('crow').innerHTML=rows.map(r=>`
    <div class="crr${r.best?' best':''}">
      <div class="crl"><div class="crd ${r.d}"></div><div>
        <p class="crn">${r.n}${r.best?'<span class=\"cbtg\">Best value</span>':''}</p>
        <p class="crt2">${r.t} &middot; ${cW}g parcel</p>
      </div></div>
      <span class="crp">~$${r.p}</span>
    </div>`).join('');
  if(show)document.getElementById('cres').classList.add('show');
}
</script>

</body></html>
