<style>
:root{
  --acc:#ff5501;--acd:#e04a00;--acl:#fff5f0;
  --bk:#0A0A0A;--g1:#1A1A1A;--g2:#2D2D2D;--g3:#555;--g4:#888;--g5:#E5E5E5;--g6:#F6F6F6;--wh:#fff;
  --gn:#16A34A;--gnl:#F0FDF4;--bl:#2563EB;--bll:#EFF6FF;
  --am:#D97706;--aml:#FFFBEB;--rd:#DC2626;--rdl:#FEF2F2;--pu:#7C3AED;--pul:#F5F3FF;
  --f:'DM Sans',sans-serif;--m:'DM Mono',monospace;--r:10px;--rl:16px;
  --nav-bg:var(--wh);--nav-h:60px;
  --footer-bg:#1A1A1A;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--f);background:var(--wh);color:var(--bk);font-size:15px;line-height:1.7;-webkit-font-smoothing:antialiased}
a{color:var(--acc);text-decoration:none}
a:hover{text-decoration:underline;text-underline-offset:3px}
img{max-width:100%;display:block}
/* NAV */
.nav{position:sticky;top:0;z-index:100;background:var(--wh);border-bottom:1px solid var(--g5);padding:0 24px;height:60px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.nbrand{display:flex;align-items:center;gap:14px;min-width:0}
.nlo{display:flex;align-items:center;flex-shrink:0}
.nlo-logo{display:block;width:162px;height:35px;object-fit:contain;object-position:left center;flex-shrink:0;border-radius:0}
.nflags{display:flex;align-items:center;gap:4px;flex-wrap:wrap}
.nregion{display:inline-flex;align-items:center}
.nregion-flag{font-size:22px;line-height:1}
.nfb{width:28px;height:28px;background:var(--acc);border-radius:6px;display:flex;align-items:center;justify-content:center;color:#fff;font-size:13px;font-weight:700}
.nl{display:flex;align-items:center;gap:4px;list-style:none}
.nl a{font-size:13px;padding:6px 10px;border-radius:6px;color:var(--g4);transition:background .15s,color .15s}
.nl a:hover{background:var(--g6);color:var(--bk);text-decoration:none}
.nl a.on{color:var(--bk);font-weight:500}
/* Announce */
.ann{background:var(--acc);color:#fff;text-align:center;padding:9px 16px;font-size:13px;font-weight:500}
.ann a{color:#fff;text-decoration:underline;text-underline-offset:3px}
/* WA button */
.bwa{display:flex;align-items:center;gap:7px;padding:7px 14px;background:#25D366;color:#fff;border-radius:8px;font-size:13px;font-weight:500;white-space:nowrap;transition:opacity .15s}
.bwa:hover{opacity:.88;text-decoration:none}
.bwa svg{width:16px;height:16px;flex-shrink:0}
/* Lang/Currency button */
.blc{display:flex;align-items:center;gap:5px;padding:6px 10px;border:1px solid var(--g5);border-radius:8px;background:var(--wh);font-family:var(--f);font-size:13px;font-weight:500;color:var(--bk);cursor:pointer;transition:border-color .15s,background .15s;white-space:nowrap}
.blc:hover,.blc.open{border-color:var(--acc);background:var(--acl)}
.blc #lc-curr{color:var(--g4);font-size:11px}
/* Lang modal backdrop */
.lbk{position:fixed;inset:0;z-index:198;background:rgba(0,0,0,.45);opacity:0;pointer-events:none;transition:opacity .25s}
.lbk.show{opacity:1;pointer-events:all}
/* Lang modal */
.lmo{position:fixed;z-index:199;background:var(--wh);border-radius:20px;box-shadow:0 20px 60px rgba(0,0,0,.18);width:360px;max-width:calc(100vw - 32px);opacity:0;pointer-events:none;transition:opacity .22s,transform .22s;transform:translateY(-8px) scale(.97)}
@media(min-width:600px){.lmo{top:62px;right:24px}.lmo.show{opacity:1;pointer-events:all;transform:translateY(0) scale(1)}.lhan{display:none}}
@media(max-width:599px){.lmo{bottom:0;left:0;right:0;width:100%;max-width:100%;border-radius:20px 20px 0 0;transform:translateY(100%);top:auto}.lmo.show{opacity:1;pointer-events:all;transform:translateY(0)}}
.lhan{width:36px;height:4px;border-radius:2px;background:var(--g5);margin:12px auto 0}
.lmi{padding:16px 20px 20px}
.lmh{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}
.lmt{font-size:15px;font-weight:600;color:var(--bk)}
.lmc{width:28px;height:28px;border-radius:50%;background:var(--g6);border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;color:var(--g3);transition:background .15s}
.lmc:hover{background:var(--g5)}
.lsl{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:var(--g4);margin-bottom:10px}
.lgr{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.lop{padding:11px 14px;border:1.5px solid var(--g5);border-radius:10px;background:var(--wh);font-family:var(--f);font-size:13.5px;font-weight:500;color:var(--bk);cursor:pointer;text-align:center;transition:border-color .15s,color .15s,background .15s;display:flex;align-items:center;justify-content:center;gap:6px}
.lop:hover{border-color:#a5b4fc}
.lop.sel{border-color:#6366F1;color:#4338CA;background:#EEF2FF;font-weight:600}
.lcf{width:100%;margin-top:18px;height:46px;background:linear-gradient(135deg,#818CF8,#6366F1);color:#fff;border:none;border-radius:12px;font-family:var(--f);font-size:15px;font-weight:600;cursor:pointer;transition:opacity .15s}
.lcf:hover{opacity:.88}
/* Breadcrumb */
.bc{padding:14px 24px;max-width:1100px;margin:0 auto;font-size:12px;color:var(--g4);display:flex;align-items:center;gap:6px;flex-wrap:wrap}
.bc a{color:var(--g4)}.bc a:hover{color:var(--bk)}
/* Page layout */
.pw{max-width:1100px;margin:0 auto;padding:0 24px 80px;display:grid;grid-template-columns:1fr 280px;gap:48px;align-items:start}
/* Prose */
.ph{font-size:21px;font-weight:600;letter-spacing:-.4px;color:var(--bk);margin-top:36px;margin-bottom:12px;padding-top:8px;border-top:1px solid var(--g5)}
.pp{font-size:15px;color:var(--g2);line-height:1.82;margin-bottom:14px}
.pul{padding-left:20px;margin-bottom:14px}
.pul li{font-size:15px;color:var(--g2);line-height:1.75;margin-bottom:7px}
/* Callout boxes */
.cb{border-radius:var(--rl);padding:14px 16px;margin:16px 0;display:flex;gap:12px;align-items:flex-start;font-size:14px;line-height:1.7}
.cb svg{flex-shrink:0;margin-top:2px}
.cb div strong{display:block;margin-bottom:3px;font-size:13px}
.tip{background:var(--acl);border:1px solid color-mix(in srgb,var(--acc) 35%,transparent);color:var(--acd)}.tip svg{color:var(--acc)}
.warn{background:var(--aml);border:1px solid #FDE68A;color:#92400E}.warn svg{color:var(--am)}
.info{background:var(--bll);border:1px solid #BFDBFE;color:#1E40AF}.info svg{color:var(--bl)}
.good{background:var(--gnl);border:1px solid #BBF7D0;color:#166534}.good svg{color:var(--gn)}
/* FAQ */
.faq-item{border:1px solid var(--g5);border-radius:var(--r);margin-bottom:10px;overflow:hidden}
.faq-q{display:flex;align-items:center;justify-content:space-between;padding:13px 15px;cursor:pointer;font-size:14px;font-weight:500;color:var(--bk);gap:12px;background:var(--wh);transition:background .12s;list-style:none}
.faq-q:hover{background:var(--g6)}
.faq-q svg{width:15px;height:15px;color:var(--g4);flex-shrink:0;transition:transform .2s}
.faq-item.open .faq-q svg{transform:rotate(180deg)}
.faq-a{padding:0 15px;max-height:0;overflow:hidden;transition:max-height .28s ease,padding .2s;font-size:13.5px;color:var(--g3);line-height:1.75}
.faq-item.open .faq-a{max-height:400px;padding:0 15px 13px}
/* Sidebar */
.asb{position:sticky;top:72px}
.sbc{border:1px solid var(--g5);border-radius:var(--rl);overflow:hidden;margin-bottom:16px}
.sbh{background:var(--g6);padding:10px 14px;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--g4)}
.sbb{padding:14px 16px}
.sbcta{margin-top:12px;padding:10px 14px;background:var(--acc);color:#fff;border-radius:8px;text-align:center;font-size:13px;font-weight:500;display:block;transition:background .15s}
.sbcta:hover{background:var(--acd);text-decoration:none}
.sbwa{margin-top:8px;padding:9px 14px;background:#25D366;color:#fff;border-radius:8px;text-align:center;font-size:13px;font-weight:500;display:flex;align-items:center;justify-content:center;gap:6px;transition:opacity .15s}
.sbwa:hover{opacity:.88;text-decoration:none}.sbwa svg{width:14px;height:14px}
.sbli{list-style:none}
.sbli li a{display:flex;align-items:center;justify-content:space-between;padding:7px 0;border-top:1px solid var(--g5);font-size:13px;color:var(--g3)}
.sbli li:first-child a{border-top:none}
.sbli li a:hover{color:var(--acc);text-decoration:none}
.sbli li a svg{width:12px;height:12px;opacity:.4}
/* Footer */
.ft{background:#1A1A1A;color:#ccc;padding:40px 24px}
.fti{max-width:1100px;margin:0 auto;display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:40px}
.flo{display:flex;align-items:center;gap:9px;font-size:15px;font-weight:600;color:#fff;margin-bottom:12px}
.flo-logo{height:26px;width:auto;max-width:150px;object-fit:contain}
.flo-txt{font-size:14px;color:#fff}
.flm{width:26px;height:26px;background:var(--acc);border-radius:6px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:#fff}
.ftg{font-size:13px;color:#888;line-height:1.65;margin-bottom:16px}
.fwa{display:inline-flex;align-items:center;gap:7px;padding:8px 14px;background:#25D366;color:#fff;border-radius:8px;font-size:13px;font-weight:500}
.fwa svg{width:15px;height:15px}
.fc h4{font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.6px;color:#888;margin-bottom:12px}
.fc ul{list-style:none}.fc ul li{margin-bottom:9px}
.fc ul li a{font-size:13px;color:#888;transition:color .12s}
.fc ul li a:hover{color:#fff;text-decoration:none}
.fb{max-width:1100px;margin:28px auto 0;padding-top:20px;border-top:1px solid #2D2D2D;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
.fb p{font-size:12px;color:#666}
/* WA float */
.waf{position:fixed;bottom:24px;right:24px;z-index:999;display:flex;flex-direction:column;align-items:flex-end;gap:8px}
.wafb{width:52px;height:52px;background:#25D366;border-radius:50%;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 16px rgba(37,211,102,.35);transition:transform .15s}
.wafb:hover{transform:scale(1.08);text-decoration:none}.wafb svg{width:26px;height:26px;color:#fff}
.wabu{background:var(--wh);border:1px solid var(--g5);border-radius:12px;padding:12px 16px;font-size:13px;max-width:200px;text-align:right;line-height:1.5;display:none}
.wabu b{color:var(--bk);display:block;margin-bottom:2px}.wabu span{color:var(--g4);font-size:12px}
.waf:hover .wabu{display:block}
/* Responsive */
@media(max-width:860px){.pw{grid-template-columns:1fr!important}.asb{position:static}.nl{display:none}.fti{grid-template-columns:1fr;gap:28px}.fb{flex-direction:column}}
/* Animations */
@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.fade-in{animation:fadeUp .4s ease both}
.fade-in-d{animation:fadeUp .4s .1s ease both}
</style>
