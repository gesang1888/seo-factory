    <script>
        // Hamburger menu toggle
        const navToggle = document.querySelector('.nav-toggle');
        const navMenu = document.getElementById('navMenu');

        navToggle.addEventListener('click', () => {
            const isOpen = navMenu.classList.toggle('open');
            navToggle.setAttribute('aria-expanded', isOpen);
            navToggle.querySelector('i').className = isOpen ? 'fas fa-times' : 'fas fa-bars';
        });

        // Mobile dropdown: tap to open (hover doesn't work on touch)
        document.querySelectorAll('.dropdown .dropdown-toggle').forEach(toggle => {
            toggle.addEventListener('click', (e) => {
                if (window.innerWidth <= 768) {
                    e.preventDefault();
                    toggle.closest('.dropdown').classList.toggle('open');
                }
            });
        });

        // Close nav after clicking a real link on mobile
        navMenu.querySelectorAll('a:not([href="javascript:;"])').forEach(link => {
            link.addEventListener('click', () => {
                navMenu.classList.remove('open');
                navToggle.setAttribute('aria-expanded', 'false');
                navToggle.querySelector('i').className = 'fas fa-bars';
            });
        });

        // Product price display: match homepage format, e.g. ¥360≈$50.00.
        (() => {
            const CNY_PER_USD = 7.2;
            const formattedFlag = 'frsPriceFormatted';
            const explicitPriceSelectors = [
                '[class*="price" i]',
                '[id*="price" i]',
                '[data-price]',
                '[data-cny]',
                '[data-yuan]'
            ];

            const skipSelector = [
                'header',
                'nav',
                'footer',
                '.top-banner',
                '.site-top-promo',
                '.header-category-strip',
                'script',
                'style',
                'noscript',
                'template',
                'input',
                'select',
                'textarea',
                'button'
            ].join(',');

            const productCardSelector = [
                '.product-card',
                '.product-item',
                '.goods-card',
                '.goods-item',
                '.item-card',
                '.list-item',
                'article',
                'li'
            ].join(',');

            const parsePlainPrice = (text) => {
                const raw = text.trim();
                if (!raw || raw.includes('≈') || /[$€£]/.test(raw)) return null;
                const match = raw.match(/^¥?\s*(\d+(?:\.\d{1,2})?)\s*(?:元|RMB|CNY)?$/i);
                if (!match) return null;

                const value = Number(match[1]);
                if (!Number.isFinite(value) || value <= 0 || value > 5000) return null;
                return value;
            };

            const formatCny = (value) => value.toFixed(0);

            const applyPriceFormat = (element) => {
                if (!element || element.dataset?.[formattedFlag] === '1' || element.closest(skipSelector)) return false;

                const value = parsePlainPrice(element.textContent);
                if (value === null) return false;

                element.textContent = `¥${formatCny(value)}≈$${(value / CNY_PER_USD).toFixed(2)}`;
                element.classList?.add('frs-price-converted');
                if (element.dataset) element.dataset[formattedFlag] = '1';
                return true;
            };

            const isLeafTextElement = (element) => {
                if (!element || element.children.length > 0 || element.closest(skipSelector)) return false;
                return parsePlainPrice(element.textContent) !== null;
            };

            const selectAllIncludingRoot = (root, selector) => {
                const elements = root.querySelectorAll ? Array.from(root.querySelectorAll(selector)) : [];
                if (root !== document && root.matches?.(selector)) elements.unshift(root);
                return elements;
            };

            const formatExplicitPrices = (root = document) => {
                selectAllIncludingRoot(root, explicitPriceSelectors.join(',')).forEach(applyPriceFormat);
            };

            const formatCardPrices = (root = document) => {
                selectAllIncludingRoot(root, productCardSelector).forEach(card => {
                    if (card.closest(skipSelector) || card.querySelectorAll('img').length !== 1) return;

                    const hasProductText = card.querySelector('h1,h2,h3,h4,[class*="title" i],a');
                    if (!hasProductText) return;

                    const firstPrice = Array.from(card.querySelectorAll('*')).find(isLeafTextElement);
                    if (firstPrice) applyPriceFormat(firstPrice);
                });
            };

            const formatProductPrices = (root = document) => {
                formatExplicitPrices(root);
                formatCardPrices(root);
            };

            const startPriceFormatter = () => {
                formatProductPrices();

                const observer = new MutationObserver(mutations => {
                    mutations.forEach(mutation => {
                        mutation.addedNodes.forEach(node => {
                            if (node.nodeType === Node.ELEMENT_NODE) formatProductPrices(node);
                        });
                    });
                });

                observer.observe(document.body, { childList: true, subtree: true });
            };

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', startPriceFormatter);
            } else {
                startPriceFormatter();
            }
        })();
    </script>
