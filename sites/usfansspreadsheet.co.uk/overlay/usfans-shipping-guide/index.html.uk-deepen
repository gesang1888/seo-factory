      <tr><td>&#127468;&#127463; UK</td><td class="tf">4&ndash;7 days</td><td class="tm">10&ndash;16 days</td><td class="tm">14&ndash;22 days</td><td class="ts">22&ndash;38 days</td><td class="mv">~$34</td></tr>
      <tr><td>&#127462;&#127482; Australia</td><td class="tf">6&ndash;10 days</td><td class="tm">12&ndash;20 days</td><td class="tm">18&ndash;30 days</td><td class="ts">30&ndash;45 days</td><td class="mv">~$40</td></tr>
