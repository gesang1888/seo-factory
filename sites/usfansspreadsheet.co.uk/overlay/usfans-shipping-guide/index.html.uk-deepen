<script>
/* ══ i18n + currency engine ══ */
const LANGS=[
  {c:'en',l:'English',f:'🇺🇸'},{c:'es',l:'Español',f:'🇪🇸'},
  {c:'de',l:'Deutsch',f:'🇩🇪'},{c:'fr',l:'Français',f:'🇫🇷'},
  {c:'it',l:'Italiano',f:'🇮🇹'},{c:'pt',l:'Português',f:'🇧🇷'},
  {c:'nl',l:'Nederlands',f:'🇳🇱'},{c:'pl',l:'Polski',f:'🇵🇱'},
  {c:'zh',l:'中文',f:'🇨🇳'},
];
const CURRS=[
  {c:'CNY',s:'¥',r:1},
  {c:'USD',s:'$',r:0.138},{c:'EUR',s:'€',r:0.127},{c:'GBP',s:'£',r:0.109},
  {c:'JPY',s:'¥',r:21.4},
  {c:'AUD',s:'A$',r:0.212},{c:'CAD',s:'C$',r:0.189},{c:'BRL',s:'R$',r:0.69},
];
const PRICE_BASE='CNY';
const T={
  en:{buy:'USFans →',no:'No products found.',sp:'Search USFans products...',mt:'Language & Currency',ml:'LANGUAGE',mc:'CURRENCY',mb:'Confirm'},
  es:{buy:'Comprar en USFans →',no:'Sin resultados.',sp:'Buscar en USFans...',mt:'Idioma y Moneda',ml:'IDIOMA',mc:'MONEDA',mb:'Confirmar'},
  de:{buy:'Auf USFans kaufen →',no:'Keine Produkte.',sp:'USFans suchen...',mt:'Sprache & Währung',ml:'SPRACHE',mc:'WÄHRUNG',mb:'Bestätigen'},
  fr:{buy:'Acheter sur USFans →',no:'Aucun résultat.',sp:'Rechercher USFans...',mt:'Langue & Devise',ml:'LANGUE',mc:'DEVISE',mb:'Confirmer'},
  it:{buy:'Acquista su USFans →',no:'Nessun prodotto.',sp:'Cerca su USFans...',mt:'Lingua e Valuta',ml:'LINGUA',mc:'VALUTA',mb:'Conferma'},
  pt:{buy:'Comprar no USFans →',no:'Sem resultados.',sp:'Buscar no USFans...',mt:'Idioma e Moeda',ml:'IDIOMA',mc:'MOEDA',mb:'Confirmar'},
  nl:{buy:'Koop via USFans →',no:'Geen producten gevonden.',sp:'Zoek USFans producten...',mt:'Taal & Valuta',ml:'TAAL',mc:'VALUTA',mb:'Bevestigen'},
  pl:{buy:'Kup na USFans →',no:'Brak produktów.',sp:'Szukaj USFans...',mt:'Język i waluta',ml:'JĘZYK',mc:'WALUTA',mb:'Potwierdź'},
  zh:{buy:'在USFans购买 →',no:'未找到商品。',sp:'搜索USFans商品...',mt:'语言与货币',ml:'语言',mc:'货币',mb:'确认'},
};
let aL=localStorage.getItem('kd_lang')||'en';
let aC=localStorage.getItem('kd_curr')||'GBP';
let pL=aL,pC=aC,mO=false;

function cvtFromCny(cny){const c=CURRS.find(x=>x.c===aC)||CURRS.find(x=>x.c===PRICE_BASE);const v=cny*c.r;return(['JPY','CNY'].includes(c.c))?c.s+Math.round(v).toLocaleString():c.s+v.toFixed(2);}
function fmtPrice(raw,cur){if(raw==null||raw==='')return'';const n=parseFloat(String(raw).replace(/[^\d.]/g,''));if(isNaN(n))return String(raw);const base=(cur||PRICE_BASE).toUpperCase();if(base!=='CNY')return String(raw);return cvtFromCny(n);}

function toggleLM(){mO?closeLM():openLM()}
function openLM(){pL=aL;pC=aC;buildG();['lang-modal','lang-backdrop'].forEach(id=>document.getElementById(id).classList.add('show'));document.getElementById('lang-btn').classList.add('open');document.body.style.overflow='hidden';mO=true;}
function closeLM(){['lang-modal','lang-backdrop'].forEach(id=>document.getElementById(id).classList.remove('show'));document.getElementById('lang-btn').classList.remove('open');document.body.style.overflow='';mO=false;}
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&mO)closeLM();});

function buildG(){
  document.getElementById('lang-grid').innerHTML=LANGS.map(l=>`<button class="lop${l.c===pL?' sel':''}" onclick="pL='${l.c}';buildG()">${l.f} ${l.l}</button>`).join('');
  document.getElementById('curr-grid').innerHTML=CURRS.map(c=>`<button class="lop${c.c===pC?' sel':''}" onclick="pC='${c.c}';buildG()">${c.c}</button>`).join('');
}
function applyLC(){
  aL=pL;aC=pC;
  localStorage.setItem('kd_lang',aL);localStorage.setItem('kd_curr',aC);
  closeLM();setBadge();applyT();
  if(typeof lp==='function')lp();else if(typeof loadProducts==='function')loadProducts();
}
function setBadge(){
  const l=LANGS.find(x=>x.c===aL)||LANGS[0];
  const c=CURRS.find(x=>x.c===aC)||CURRS[0];
  const btn=document.getElementById('lang-btn');
  if(!btn||!l||!c)return;
  document.getElementById('lc-flag').textContent=l.f;
  document.getElementById('lc-lang').textContent=l.c.toUpperCase();
  document.getElementById('lc-curr').textContent='· '+c.c;
}
function applyT(){
  const t=T[aL]||T.en;
  document.querySelectorAll('[data-t]').forEach(el=>{const k=el.getAttribute('data-t');if(t[k])el.textContent=t[k];});
  const si=document.getElementById('search-input');if(si)si.placeholder=t.sp;
}
function toggleFaq(el){const i=el.closest('.faq-item'),w=i.classList.contains('open');document.querySelectorAll('.faq-item').forEach(x=>x.classList.remove('open'));if(!w)i.classList.add('open');}
document.addEventListener('DOMContentLoaded',()=>{buildG();setBadge();applyT();if(typeof lp==='function')lp();});
</script>

</body></html>
