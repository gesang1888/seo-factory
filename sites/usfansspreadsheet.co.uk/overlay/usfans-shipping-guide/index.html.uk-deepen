<script>
const RATES={"us": {"dhl": [38, 8.0], "ems": [24, 4.8], "ecoA": [16, 3.0], "ecoB": [11, 1.9]}, "uk": {"dhl": [34, 7.2], "ems": [21, 4.2], "ecoA": [14, 2.7], "ecoB": [10, 1.7]}, "de": {"dhl": [33, 7.0], "ems": [20, 4.0], "ecoA": [13, 2.5], "ecoB": [9, 1.6]}, "fr": {"dhl": [34, 7.2], "ems": [21, 4.2], "ecoA": [14, 2.7], "ecoB": [10, 1.7]}, "other": {"dhl": [42, 9.0], "ems": [28, 5.5], "ecoA": [19, 3.6], "ecoB": [14, 2.3]}};
let cW=700;
function sw2(g){cW=g;document.getElementById('cw').value=g;document.querySelectorAll('.cpr').forEach(b=>b.classList.toggle('on',b.textContent.includes(g+'g')||b.textContent.includes((g/1000).toFixed(1)+'kg')));cu();}
function cc2(){const m={'shoes':700,'clothing':350,'jacket':1200,'bag':1100,'accessories':200};const v=document.getElementById('ccat').value;if(m[v]){cW=m[v];document.getElementById('cw').value=cW;}cu();}
function cu(show){
  const c=document.getElementById('cc').value;
  cW=parseInt(document.getElementById('cw').value)||700;
  const r=RATES[c]||RATES['other'];
  const calc=(b,e)=>Math.round((b+Math.max(0,Math.round((cW-700)/100))*e)*10)/10;
  const rows=[
    {n:'DHL Express',d:'df',t:'5&ndash;10 days',p:calc(r.dhl[0],r.dhl[1]),best:false},
    {n:'EMS',d:'dm',t:'10&ndash;20 days',p:calc(r.ems[0],r.ems[1]),best:false},
    {n:'Economy Line A',d:'dm',t:'15&ndash;30 days',p:calc(r.ecoA[0],r.ecoA[1]),best:true},
    {n:'Economy Line B',d:'ds',t:'25&ndash;45 days',p:calc(r.ecoB[0],r.ecoB[1]),best:false},
  ];
  document.getElementById('crow').innerHTML=rows.map(r=>`
    <div class="crr${r.best?' best':''}">
      <div class="crl"><div class="crd ${r.d}"></div><div>
        <p class="crn">${r.n}${r.best?'<span class=\"cbtg\">Best value</span>':''}</p>
        <p class="crt2">${r.t} &middot; ${cW}g parcel</p>
      </div></div>
      <span class="crp">~$${r.p}</span>
    </div>`).join('');
  if(show)document.getElementById('cres').classList.add('show');
}
</script>
